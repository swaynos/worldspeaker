        },
        "effectsPerCharacterPerSecond": {
          "const": 1
        },
        "inFlightPerCharacter": {
          "const": 1
        },
        "audioRangeBlocks": {
          "const": 32
        },
        "audioVolumeMax": {
          "const": 1
        },
        "audioRecipientsMax": {
          "const": 32
        },
        "stepsMax": {
          "const": 2
        },
        "resultUtf8Bytes": {
          "const": 4096
        },
        "prohibitedMutations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "target",
        "scope",
        "freshness",
        "revalidation"
      ],
      "properties": {
        "request": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "type": "string",
          "minLength": 1
        },
        "revalidation": {
          "type": "string",
          "minLength": 1
