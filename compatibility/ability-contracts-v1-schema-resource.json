          "type": "string",
          "minLength": 1
        },
        "duplicates": {
          "type": "string",
          "minLength": 1
        },
        "durability": {
          "type": "string",
          "minLength": 1
        },
        "preOperation": {
          "type": "string",
          "minLength": 1
        },
        "postOperation": {
          "type": "string",
          "minLength": 1
