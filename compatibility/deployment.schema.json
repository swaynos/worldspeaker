{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspeaker.invalid/schema/compatibility-deployment-v1.json",
  "title": "Worldspeaker deployment contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deploymentId", "manifestRevision", "mod", "target", "runtimeDependencies", "installationTools", "upstreamArtifacts", "buildDependencies", "openclaw", "companion", "transport", "optionalIntegrations", "availableFeatures", "unavailableAbilities", "qualification"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deploymentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "manifestRevision": { "type": "string", "minLength": 1 },
    "mod": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "const": "worldspeaker" }, "version": { "type": "string", "minLength": 1 } }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["selection", "minecraft", "loader", "serverOnly", "java"],
      "properties": {
        "selection": { "const": "selected" },
        "minecraft": { "const": "1.21.1" }, "loader": { "const": "fabric" }, "serverOnly": { "const": true },
        "java": {
          "type": "object", "additionalProperties": false,
          "required": ["major", "vendor", "runtimeVersion", "distribution", "platform"],
          "properties": {
            "major": { "const": 21 }, "vendor": { "type": "string", "minLength": 1 },
            "runtimeVersion": { "type": "string", "minLength": 1 }, "distribution": { "type": "string", "minLength": 1 }, "platform": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "runtimeDependencies": {
      "type": "object", "additionalProperties": false, "required": ["fabricLoader", "fabricApi"],
      "properties": { "fabricLoader": { "type": "string", "minLength": 1 }, "fabricApi": { "type": "string", "minLength": 1 } }
    },
    "installationTools": {
      "type": "object", "additionalProperties": false, "required": ["fabricInstaller"],
      "properties": { "fabricInstaller": { "type": "string", "minLength": 1 } }
    },
    "upstreamArtifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["minecraftServerSha1", "minecraftClientSha1", "temurinJdkSha256", "gradleDistributionSha256", "openclawNpmIntegrity"],
      "properties": {
        "minecraftServerSha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "minecraftClientSha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "temurinJdkSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "gradleDistributionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "openclawNpmIntegrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]{86}==$" }
      }
    },
    "buildDependencies": {
      "type": "object", "additionalProperties": false, "required": ["gradle", "fabricLoom", "yarnMappings", "yarnClassifier", "javaTestBom"],
      "properties": { "gradle": { "type": "string" }, "fabricLoom": { "type": "string" }, "yarnMappings": { "type": "string" }, "yarnClassifier": { "const": "v2" }, "javaTestBom": { "type": "string" } }
    },
    "openclaw": {
      "type": "object", "additionalProperties": false, "required": ["package", "version", "node", "nodeRange", "npm", "pluginApiStability"],
      "properties": { "package": { "const": "openclaw" }, "version": { "type": "string" }, "node": { "type": "string" }, "nodeRange": { "type": "string" }, "npm": { "type": "string" }, "pluginApiStability": { "const": "experimental" } }
    },
    "companion": {
      "type": "object", "additionalProperties": false, "required": ["package", "version", "protocol", "websocket", "typescript", "nodeTypes", "websocketTypes"],
      "properties": { "package": { "type": "string" }, "version": { "type": "string" }, "protocol": { "type": "string" }, "websocket": { "type": "string" }, "typescript": { "type": "string" }, "nodeTypes": { "type": "string" }, "websocketTypes": { "type": "string" } }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "developmentBind", "developmentScheme", "nonLoopbackScheme", "maxFrameBytes", "handshakeTimeoutMs", "heartbeatIntervalMs", "peerExpiryMs", "maxWaitingOutboundFrames", "maxBoundConnections", "reconnectDelaysMs"],
      "properties": {
        "owner": { "type": "string" }, "developmentBind": { "const": "127.0.0.1" }, "developmentScheme": { "const": "ws" }, "nonLoopbackScheme": { "const": "wss" },
        "maxFrameBytes": { "const": 16384 }, "handshakeTimeoutMs": { "const": 5000 }, "heartbeatIntervalMs": { "const": 5000 }, "peerExpiryMs": { "const": 10000 },
        "maxWaitingOutboundFrames": { "const": 16 }, "maxBoundConnections": { "const": 1 }, "reconnectDelaysMs": { "const": [1000, 2000, 4000] }
      }
    },
    "optionalIntegrations": {
      "type": "object", "additionalProperties": false,
      "required": ["permissionPlugin", "externalClaimsAdapter", "rconBridge", "clientMod", "resourcePack"],
      "properties": { "permissionPlugin": { "type": ["string", "null"] }, "externalClaimsAdapter": { "type": ["string", "null"] }, "rconBridge": { "type": ["string", "null"] }, "clientMod": { "type": ["string", "null"] }, "resourcePack": { "type": ["string", "null"] } }
    },
    "availableFeatures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "unavailableAbilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "qualification": {
      "type": "object", "additionalProperties": false, "required": ["state", "evidence"],
      "properties": { "state": { "enum": ["unqualified", "qualified"] }, "evidence": { "type": "array", "items": { "type": "string" } } },
      "allOf": [
        { "if": { "type": "object", "required": ["state"], "properties": { "state": { "const": "qualified" } } }, "then": { "type": "object", "properties": { "evidence": { "type": "array", "minItems": 1 } } } },
        { "if": { "type": "object", "required": ["state"], "properties": { "state": { "const": "unqualified" } } }, "then": { "type": "object", "properties": { "evidence": { "type": "array", "maxItems": 0 } } } }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["qualification"],
        "properties": { "qualification": { "type": "object", "required": ["state"], "properties": { "state": { "const": "unqualified" } } } }
      },
      "then": { "type": "object", "properties": { "availableFeatures": { "type": "array", "maxItems": 0 } } }
    }
  ]
}
